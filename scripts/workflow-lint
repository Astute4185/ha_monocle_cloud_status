#!/usr/bin/env bash
set -euo pipefail

if command -v actionlint >/dev/null 2>&1; then
  exec actionlint "$@"
fi

if command -v docker >/dev/null 2>&1; then
  exec docker run --rm \
    -v "$PWD:/repo" \
    -w /repo \
    rhysd/actionlint:1.7.12 "$@"
fi

echo "actionlint is required. Install actionlint or Docker, then retry." >&2
exit 2
